<?xml version="1.0" encoding="utf-8"?>
<!--
  TRAMES launcher icon — background layer.

  Original work for TRAMES, not derived from any OsmAnd artwork. OsmAnd's res/ is
  CC-BY-NC-ND 4.0 (No Derivatives), so branding is REPLACED with new files rather than
  edited. Nothing here is copied from or based on theirs.

  Adaptive-icon canvas is 108x108dp; only the centre 72x72 is guaranteed visible, so
  the background is a flat field with no detail near the edges.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#161A20"
        android:pathData="M0,0h108v108h-108z" />
    <!-- faint diagonal wash so the icon isn't a dead flat rectangle -->
    <path
        android:fillColor="#1E242C"
        android:pathData="M0,108 L108,0 L108,108 z" />
</vector>
