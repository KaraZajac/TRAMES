<?xml version="1.0" encoding="utf-8"?>
<!--
  TRAMES ALPR camera map marker. Original work for TRAMES.

  Silhouette of a pole-mounted ALPR unit: the boxy housing with a lens, the mount arm,
  and the solar panel that makes Flock's units recognisable on the street. Drawn white
  on a filled disc so it reads at marker size against both light and dark map styles,
  and sits at similar visual weight to OsmAnd's own POI pins.

  24dp viewport, glyph inset so the disc edge isn't clipped when scaled.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- disc -->
    <path
        android:fillColor="#D9584B"
        android:pathData="M12,12 m-11,0 a11,11 0 1,0 22,0 a11,11 0 1,0 -22,0" />
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.4"
        android:pathData="M12,12 m-11,0 a11,11 0 1,0 22,0 a11,11 0 1,0 -22,0" />

    <!-- solar panel -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M5.6,5.2 L15.2,5.2 L15.2,6.5 L5.6,6.5 z" />
    <!-- mast -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M9.8,6.5 L11.0,6.5 L11.0,18.6 L9.8,18.6 z" />
    <!-- camera housing -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M11.0,8.6 L17.6,8.6 A1.1,1.1 0 0,1 18.7,9.7 L18.7,12.6
                          A1.1,1.1 0 0,1 17.6,13.7 L11.0,13.7 z" />
    <!-- lens -->
    <path
        android:fillColor="#D9584B"
        android:pathData="M16.6,11.15 m-1.5,0 a1.5,1.5 0 1,0 3,0 a1.5,1.5 0 1,0 -3,0" />
</vector>
