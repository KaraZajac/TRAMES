<?xml version="1.0" encoding="utf-8"?>
<!--
  TRAMES-owned resources.

  A NEW values file rather than additions to OsmAnd's strings.xml / styles.xml /
  colors.xml. OsmAnd's res/ is CC-BY-NC-ND 4.0 (No Derivatives), so everything TRAMES
  adds lives in its own files; theirs are used unmodified or replaced wholesale, never
  edited in place. Keeping all TRAMES resources here also means the fork's additions
  are trivially auditable and don't conflict on upstream rebases.
-->
<resources>

    <!-- ── branding ─────────────────────────────────────────────────────────── -->
    <color name="trames_splash_background">#161A20</color>

    <style name="FirstSplashScreenTrames" parent="SplashScreenBaseTheme">
        <item name="android:windowBackground">@drawable/trames_splash_screen</item>
    </style>

    <!-- ── ALPR avoidance routing ───────────────────────────────────────────── -->
    <string name="trames_routing_engine_title">TRAMES (ALPR avoidance)</string>
    <string name="trames_berth_title">Camera avoidance</string>
    <string name="trames_berth_descr">How hard to avoid roads watched by licence-plate readers. Stronger settings take longer routes.</string>

    <!--
      Slider labels. The underlying GraphHopper priority multiplier is NOT linear and
      its useful range is roughly 0.3 down to 0.01 — measured on the continental graph,
      everything from 1.0 to 0.3 changes nothing on most routes. Exposing raw numbers
      would give the user a control that appears dead for two thirds of its travel, so
      the UI offers named steps mapped onto the range that actually does something.
    -->
    <string name="trames_berth_off">Off — fastest route</string>
    <string name="trames_berth_light">Light — avoid where it\'s cheap</string>
    <string name="trames_berth_moderate">Moderate</string>
    <string name="trames_berth_strong">Strong</string>
    <string name="trames_berth_maximum">Maximum — avoid all cameras</string>


    <!-- Route exposure readout -->
    <string name="trames_exposure_none">No licence-plate readers can see this route</string>
    <string name="trames_exposure_count">%1$d licence-plate reader(s) can see this route</string>

    <!--
      Offline avoidance levels. These names are not free-form: OsmAnd looks up a routing
      parameter's label as routing_attr_<id>_name / _description (see
      AndroidUtils.getRoutingStringPropertyName), and a group's label as
      routing_attr_<group>_name — so they must match the `alpr_avoidance` group and its
      five ids that trames-patch-resources.sh adds to routing.xml. Defined here rather
      than in OsmAnd's strings.xml because that file is CC-BY-NC-ND — see the header.

      The level names deliberately mirror the online berth labels above: the same word
      means the same multiplier whichever engine is routing.
    -->
    <string name="routing_attr_alpr_avoidance_name">Camera avoidance</string>
    <string name="routing_attr_alpr_avoidance_description">How hard to avoid roads watched by licence-plate readers</string>
    <string name="routing_attr_alpr_off_name">Off — fastest route</string>
    <string name="routing_attr_alpr_off_description">Do not avoid licence-plate readers</string>
    <string name="routing_attr_alpr_light_name">Light</string>
    <string name="routing_attr_alpr_light_description">Avoid readers only where the detour is nearly free</string>
    <string name="routing_attr_alpr_moderate_name">Moderate</string>
    <string name="routing_attr_alpr_moderate_description">A balanced trade between detour and exposure</string>
    <string name="routing_attr_alpr_strong_name">Strong</string>
    <string name="routing_attr_alpr_strong_description">Avoid readers wherever a reasonable alternative exists</string>
    <string name="routing_attr_alpr_max_name">Maximum</string>
    <string name="routing_attr_alpr_max_description">Avoid every reader it can find a way around</string>

    <!-- ── offline map catalogue (TramesMapsDialog) ─────────────────────────── -->
    <string name="trames_maps_title">TRAMES offline maps</string>
    <string name="trames_maps_descr">Maps with licence-plate readers built in, so offline routing avoids them</string>
    <string name="trames_maps_loading">Loading available maps…</string>
    <string name="trames_maps_unavailable">Could not reach the TRAMES map server. Check your connection and try again.</string>
    <string name="trames_maps_installed">installed</string>
    <string name="trames_maps_download_prompt">Download the %1$s map (%2$s)? It replaces the standard map for that area and lets offline routing avoid cameras there.</string>
    <string name="trames_maps_redownload_prompt">%1$s is already installed. Download it again (%2$s) to pick up newly added cameras?</string>
    <string name="trames_maps_downloading">Downloading %1$s…</string>
    <string name="trames_maps_ready">%1$s is ready — offline routing now avoids cameras there</string>
    <string name="trames_maps_failed">Download failed: %1$s</string>

</resources>
